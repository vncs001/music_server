# Senha que o app usa para falar com o servidor (cole a mesma no app, em CONFIG).
# Gere uma com:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=

# Apaga do servidor os MP3 com mais de N horas (o celular já guardou a cópia dele)
MAX_FILE_AGE_HOURS=24
MAX_PARALLEL_DOWNLOADS=2

# Opcional: chave da YouTube Data API v3. Sem ela = busca pelo yt-dlp (sem chave, sem cota)
# YOUTUBE_API_KEY=

# Opcional: cookies de uma conta do YouTube, se a VPS for bloqueada ("Sign in to confirm you're not a bot")
# COOKIES_FILE=/secrets/cookies.txt
